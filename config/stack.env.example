# Runtime paths. Keep these host-neutral and absolute.
DOCKER_DIR=/opt/docker
DOCKER_DATA_DIR=/opt/docker/data
DOCKER_APP_DIR=/opt/docker/apps
LXC_REMUX_ROOT=/opt/lxc-remux-stack
LXC_REMUX_RUNTIME_DIR=/opt/lxc-remux-stack/runtime

# Compose identity and the shared application network.
COMPOSE_PROJECT_NAME=aio
COMPOSE_PROFILES=required,aiostreams,remux
DOCKER_NETWORK=aio_network
DOCKER_NETWORK_EXTERNAL=false
DOCKER_NETWORK_CIDR=<SET_UNUSED_PRIVATE_DOCKER_CIDR>

# Operator-selected host settings.
TZ=Europe/Rome
PUID=1000
PGID=1000
DOMAIN=<BASE_DOMAIN>
AUTHELIA_HOSTNAME=<AUTHELIA_HOSTNAME>
AIOSTREAMS_HOSTNAME=<AIOSTREAMS_HOSTNAME>
REMUX_HOSTNAME=<REMUX_HOSTNAME>
TRAEFIK_HOSTNAME=<TRAEFIK_HOSTNAME>

# LAN validation binds. These do not authorize WAN forwarding.
TRAEFIK_HTTP_BIND=127.0.0.1:8080
TRAEFIK_HTTPS_BIND=0.0.0.0:8443
TRUSTED_IPS=127.0.0.1/32

# Local secrets. scripts/bootstrap.sh replaces these markers in runtime/stack.env.
AUTHELIA_SESSION_SECRET=<GENERATE_64_CHAR_SECRET>
AUTHELIA_STORAGE_ENCRYPTION_KEY=<GENERATE_64_CHAR_SECRET>
AUTHELIA_JWT_SECRET=<GENERATE_64_CHAR_SECRET>
AUTHELIA_POSTGRES_PASSWORD=<GENERATE_64_CHAR_SECRET>
AUTHELIA_WEBAUTHN_DISPLAY_NAME=Remux Stack

# Reviewed image candidates. Runtime validation records the resolved digest.
AIOSTREAMS_IMAGE=ghcr.io/viren070/aiostreams:v2.34.0@sha256:d25546200337f633b25fd8bd95ee8dc9ef936573fb80e77cc4e2fe1f120c40ae
REMUX_IMAGE=ghcr.io/lostb1t/remux:0.31.0@sha256:4406d6a005a3ebe2e8e9f250ebaa07085d808d18051c692790a7cfc099a575e1
AUTHELIA_IMAGE=ghcr.io/authelia/authelia:4.39.20@sha256:1b363e9279e742397966333f364e0876ae02bf5c876de73e83af6d48c57ff51b
POSTGRES_IMAGE=postgres:17.11-alpine3.24@sha256:18cfe3ef5e6815560c98237d6216d1e5119702fb0f3894c8785dd58b8bbe5d73
REDIS_IMAGE=redis:7.4.11-alpine@sha256:ff02b58f971e7d7d156a1267e283fcbbeee91773b6aa36c49dac28ecfe28eadf
TRAEFIK_IMAGE=traefik:v3.7.13@sha256:f86a2cab1b5c649070c49f883c743dd32d8485a56e3368c5f93b9e91f1e91259
SOCKET_PROXY_IMAGE=lscr.io/linuxserver/socket-proxy:latest@sha256:ba211325155c463a1a6e6a038c928f21447a8e60ce02ecf41302047974097e84
